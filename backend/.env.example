# =============================================================================
# Agentic AI-Based Sentiment Analysis Management System
# Backend environment example. Copy to `.env` and fill in real values.
# Never commit `.env` to source control. Never commit a real API key.
# This file is the canonical source of truth for every variable the
# backend reads. The same set is documented in docs/production_deployment.md
# and baked into docker-compose.yml. Keep all three in sync.
# =============================================================================

# --- Core Flask / security ---
FLASK_ENV=development
SECRET_KEY=change-me-in-production-32-bytes-min
JWT_SECRET_KEY=change-me-too-32-bytes-min
FRONTEND_URL=http://localhost:5173

# --- Database ---
# SQLite default for development. PostgreSQL in production (psycopg v3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sentiment_dev
# Override for the test suite (defaults to in-memory SQLite).
# TEST_DATABASE_URL=sqlite:///:memory:
# Connection-pool tuning (production only).
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=1800

# --- CORS / proxy trust ---
# Comma-separated exact origins for the production CORS allowlist.
# Never "" or "*". For local dev a single origin (the Vite dev server)
# is sufficient.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Number of trusted reverse-proxy layers in front of the app. 0 means
# the app faces the internet directly and X-Forwarded-* headers are
# NOT trusted.
# TRUSTED_PROXY_COUNT=0

# --- Rate limiting ---
# Per-route limits are wired in app/limiter.py.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=200 per minute
# Storage backend. ``memory://`` is the default (single-process only).
# Set to ``redis://host:6379/0`` to share the limiter across replicas.
# LIMITER_STORAGE_URL=memory://

# --- Token revocation (multi-instance state) ---
# Optional. If unset, the in-memory revocation store is used (single
# process only). Set to ``redis://host:6379/0`` for multi-instance
# deployments; the ``redis`` package is already pinned in
# requirements.txt. Behaviour is runtime-verified against a real
# Redis 5.0 server (scripts/phase14_distributed_verification.py).
# REVOCATION_STORE_URL=
# Key prefix (only used when REVOCATION_STORE_URL points at Redis).
# REVOCATION_STORE_PREFIX=sams:revoked:

# --- Structured logging ---
# LOG_JSON=true
# LOG_LEVEL=INFO

# --- Web-data collection (Phase 6) ---
SCRAPER_REQUEST_TIMEOUT_SECONDS=15
SCRAPER_REQUEST_DELAY_SECONDS=1
SCRAPER_MAX_PAGES=10
SCRAPER_MAX_RECORDS=500
SCRAPER_MAX_RESPONSE_MB=5
SCRAPER_MAX_RETRIES=2
SCRAPER_MAX_REDIRECTS=5
SCRAPER_USER_AGENT=AgenticSentimentSystem/1.0 (+https://example.com)
# DEV/TEST ONLY. Never enable in any environment reachable from the internet.
# Allows collection from localhost / private IPs for local mock servers.
# SCRAPER_ALLOW_PRIVATE_TARGETS=false

# --- Reddit (optional, opt-in OAuth) ---
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=SentimentAnalysisSystem/1.0

# --- Agentic orchestration engine ---
# How a workflow is walked. This selects the *runner*, never what an agent
# computes: both engines call the same nine services with the same inputs.
#   "deterministic" (default) - plain-Python for-loop orchestrator
#                              (app/services/agents/orchestrator.py)
#   "langgraph"               - StateGraph orchestrator
#                              (app/services/agents/langgraph_orchestrator.py)
# Neither engine contains an LLM. An unrecognised value falls back to
# "deterministic" rather than failing the request.
# AGENTIC_ENGINE=deterministic

# --- Optional LLM interpretation layer (Phase 9) ---
# Choices:
#   "deterministic" (default) — always available, no network, no key
#   "openai_compatible"     — any chat-completions endpoint (OpenAI, Azure,
#                              Together, vLLM, Ollama /v1, LM Studio, etc.)
#   "stub"                  — for tests; programmable response queue
LLM_PROVIDER=deterministic
# Required only when LLM_PROVIDER=openai_compatible:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=512

# --- Optional business-context website extraction (Phase 9) ---
# Same safety controls as the rest of the collection layer.
# The website URL itself is supplied per-project via the UI/API. These
# environment variables tune the bounded single-page extraction.
# (Reuses SCRAPER_REQUEST_TIMEOUT_SECONDS, SCRAPER_MAX_RESPONSE_MB,
#  SCRAPER_USER_AGENT — see above.)

# --- Optional sentiment engine (Phase 9) ---
# Choices:
#   "vader" (default) — the original VaderSentimentAnalyzer
#   "stub"           — a small built-in lexicon used for tests and
#                      offline smoke testing; NOT a production model
SENTIMENT_ENGINE=vader

# --- Object storage (Phase 13) ---
# STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=s3:
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_KEY_PREFIX=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- File paths ---
# UPLOAD_FOLDER=
# REPORT_OUTPUT_DIRECTORY=

# --- Analysis tuning (all optional; defaults shown) ---
# DEFAULT_TOPIC_COUNT=8
# MAX_TOPIC_COUNT=20
# KEYWORD_BLOCKED_WORDS=
# RECOMMENDATION_MIN_FREQUENCY=3
# MAX_REPORT_REVIEW_ROWS=500
# DEFAULT_ALERT_WINDOW_DAYS=7

# --- Server runtime (windows/waitress runner: python -m app.runner) ---
# Docker image uses gunicorn instead; these are ignored there.
# PORT=5000
# BIND_ADDRESS=0.0.0.0
# WEB_CONCURRENCY=4

# --- Source fallback discovery (leave alone) ---
# Metadata-only discovery mode for the controlled source-fallback
# registry. Do not change unless you are working on that subsystem.
# SOURCE_FALLBACK_DISCOVERY_MODE=CURATED_ONLY
